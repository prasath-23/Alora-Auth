# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
/vendor/

# ── Build output ────────────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.test
*.out
dist/
build/

# ── Secrets / local environment ─────────────────────────────────────────────
# .env holds real credentials and signing keys; only the example is tracked.
.env
.env.*
!.env.example
*.pem
*.key

# ── Test artefacts ──────────────────────────────────────────────────────────
test-results/
playwright-report/
blob-report/
.playwright/

# ── OS / IDE ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── AI agents: personal, never shared ───────────────────────────────────────
# AGENTS.md, CLAUDE.md, .claude/agents/ and .claude/rules/ are tracked; these
# hold one person's permissions and notes.
.claude/settings.local.json
CLAUDE.local.md

# ── Logs ────────────────────────────────────────────────────────────────────
*.log

# ── Pinned code generators ──────────────────────────────────────────────────
# alora-auth-go/scripts/generate.sh installs buf and the protoc plugins here.
alora-auth-go/.bin/

# NOTE: sqlc-generated code under alora-auth-api/internal/database/sqlc
# IS tracked, so a fresh clone builds without running codegen. So is the gRPC
# code under alora-auth-go/authpb, so products can `go get` it.
