# Normalise to LF in the repository. Without this, Git's autocrlf on Windows
# rewrites checkouts to CRLF, which breaks the shell scripts outright (a trailing
# \r on the shebang makes the interpreter unfindable) and produces whole-file
# diffs between platforms.
* text=auto eol=lf

*.png binary
*.jpg binary
*.pdf binary

# Generated by sqlc — tracked so a fresh clone builds, but collapsed in diffs and
# excluded from language statistics.
alora-auth-api/internal/database/sqlc/** linguist-generated=true
