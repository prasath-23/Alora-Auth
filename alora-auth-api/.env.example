# Alora Auth (Go) — environment. Copy to .env and fill in. Required vars are
# asserted at startup (config.Load); production additionally rejects placeholder
# secrets and a COOKIE_SECRET shorter than 32 bytes.

# --- Server ---
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173
# Comma-separated proxy CIDRs/IPs Gin may trust for X-Forwarded-* (empty = trust none).
TRUSTED_PROXIES=

# --- Database (required) ---
DATABASE_URL=postgresql://admin:password@localhost:5432/alora_auth

# --- JWT / RS256 (required). PEM may use literal \n which config converts to newlines. ---
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=alora-key-1
JWT_ISSUER=https://auth.alora.io
JWT_API_AUDIENCE=alora-auth-api
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# --- Cookies (COOKIE_SECRET required; >=32 bytes in prod) ---
COOKIE_SECRET=change-this-to-a-long-random-string-at-least-32-bytes
# Empty = host-only cookie; set to e.g. .alora.io for cross-subdomain SSO.
COOKIE_DOMAIN=

# --- Google OAuth (required) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# --- Mail (optional; empty MAIL_HOST disables email → invite_url is returned) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# --- Rate limits ---
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTHORIZE_IP_MAX=10
RATE_LIMIT_AUTHORIZE_EMAIL_MAX=5
