# Alora App Central (Go) — environment. Copy to .env and fill in. Required
# variables are asserted at startup (config.Load); production additionally
# rejects placeholder secrets, plain-http origins and a COOKIE_SECRET shorter
# than 32 bytes. Variables an earlier version read (COOKIE_DOMAIN,
# JWT_API_AUDIENCE, JWT_REFRESH_EXPIRES_DAYS) are refused with what replaced them.

# --- Server ---
# development | test | production (anything else is refused).
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
# App Central's origin: where the SPA is served, and where sign-in, invitation
# and reset links point. In production it is the same origin as JWT_ISSUER —
# App Central and its API are served together — and must be https.
FRONTEND_URL=http://localhost:5173
# Comma-separated proxy CIDRs/IPs Gin may trust for X-Forwarded-* (empty = trust none).
TRUSTED_PROXIES=

# --- gRPC (applications' tokens) ---
# The port TokenService listens on, for applications getting tokens with client
# credentials over gRPC. Empty or 0: no gRPC listener. Every call carries a
# client secret, so in production it needs TLS: a certificate and key here, or
# GRPC_BEHIND_TLS_PROXY=true when a proxy in front terminates TLS (then list the
# proxy in TRUSTED_PROXIES, so budgets see the caller's address, not the proxy's).
GRPC_PORT=
GRPC_TLS_CERT=
GRPC_TLS_KEY=
GRPC_BEHIND_TLS_PROXY=false

# Serve the OpenAPI document and Swagger UI at /docs. Defaults to true outside
# production and false in it: the document maps the whole admin surface and the
# UI is a request console pointed at this origin, which is free reconnaissance to
# publish from an identity provider. Set explicitly to override either default.
DOCS_ENABLED=true

# --- Database (required) ---
# Connect as the least-privilege role (alora-auth-db/Security/roles.sql), never
# as the schema owner. cmd/bootstrap is the one thing that uses the owner.
DATABASE_URL=postgresql://alora_app:password@localhost:5432/alora_auth

# Connection-pool size. Set these rather than pool_* parameters in DATABASE_URL;
# the parameters there are superseded, so there is one place to look.
#
# MaxConns is per PROCESS. The database sees DB_MAX_CONNS x replicas, and a
# default Postgres refuses connections past 100 — at which point logins fail
# while the application looks healthy. Size it against max_connections, not
# against the API's CPU count (which is what pgx would otherwise use).
DB_MAX_CONNS=10
# Connections kept warm, so a login never waits for a new connection.
DB_MIN_CONNS=2

# --- Token signing (required) ---
# RS256. PEM may use literal \n, which config converts to newlines.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=alora-key-1
# The issuer every token names and every product verifies, byte for byte: an
# origin with no trailing slash. OpenID discovery is served under it.
JWT_ISSUER=http://localhost:5173
# Retiring a key: publish it here as verify-only while its tokens age out, as
# kid=PEM pairs separated by ";" (JWKS then carries both).
JWT_VERIFY_KEYS=
# Lifetime of every access token: App Central's own and each product's.
JWT_ACCESS_EXPIRES_IN=15m
# The audience of App Central's own access tokens — the only tokens /api accepts.
# A product's tokens carry product:<key> instead.
APP_CENTRAL_AUDIENCE=app-central

# --- Sessions ---
# An App Central session lives this long without use, and never longer than the cap.
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=14
# A product's refresh token (held by the product's backend); capped by its App Central session.
PRODUCT_REFRESH_TTL=12h
# The Owner console needs a sign-in at most this old.
OWNER_MAX_AUTH_AGE=12h

# --- Cookies (required; >= 32 bytes in production) ---
# Signs the short-lived sign-in cookies. Every cookie is host-only; production
# adds the __Host- prefix.
COOKIE_SECRET=change-this-to-a-long-random-string-at-least-32-bytes

# --- Google sign-in (optional: all three, or none) ---
# The redirect URI is App Central's callback, e.g.
# http://localhost:5173/auth/google/callback — register it with Google as is.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Company SSO (OpenID Connect) ---
# Seals each connection's client secret at rest (AES-256-GCM): 32 random bytes,
# base64 (openssl rand -base64 32). Required in production. Changing it makes
# stored secrets unreadable; rotate by re-entering each connection's secret.
SSO_SECRET_KEY=
SSO_SECRET_KEY_ID=k1
# Where identity providers send users back; register it with each provider.
# Defaults to FRONTEND_URL + /auth/sso/callback.
SSO_REDIRECT_URI=

# --- Mail (optional) ---
# Empty MAIL_HOST disables email. Outside production the invite and reset
# links are then returned by the API instead; in production a reset without
# mail is refused.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# --- Rate limits ---
# Per address, per minute, across the whole API (the OAuth endpoints a product's
# backend calls have their own budget, keyed by client).
RATE_LIMIT_GLOBAL_MAX=100
# Password sign-in attempts per minute, per address and email together.
RATE_LIMIT_AUTHORIZE_IP_MAX=10
# Multiplies every other per-route budget (refresh, discovery, invitations,
# password changes, the OAuth endpoints). Raise it for many users behind one
# egress address.
RATE_LIMIT_SCALE=1
# Where the brute-force-sensitive budgets (password sign-in, the token endpoint,
# failed client authentications, per-account password change) keep their
# counters: "memory" (per process) or "database" (shared across instances).
# Behind a load balancer use "database", or N replicas grant N times each budget.
RATE_LIMIT_STORE=memory
