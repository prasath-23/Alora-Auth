# Backend the Vite dev server proxies /auth, /admin and /health to.
#
# This is the Go/Gin API (alora-auth-go), which listens on :3001 by default —
# the same port the retired Fastify service used, so no change is required for a
# standard local setup. Override only if you run the API elsewhere.
VITE_API_URL=http://127.0.0.1:3001
